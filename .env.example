# ------------------------------------------------------------
# ReadySpace WebSpace Headless WordPress environment settings
# ------------------------------------------------------------

# The WordPress backend URL.
# Do not add /wp-admin, /graphql, or a trailing slash.
NEXT_PUBLIC_WORDPRESS_URL=https://cms.brightpath.example

# The public URL that visitors and search engines use.
# Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://brightpath.example

# Find this value inside:
# WordPress Admin → Settings → Faust → Secret Key
#
# Never put a real secret inside this example file.
FAUST_SECRET_KEY=replace-with-your-faust-secret

# ------------------------------------------------------------
# Optional Google integrations
# ------------------------------------------------------------

# Google Tag Manager web container ID, for example GTM-ABCDEFG.
NEXT_PUBLIC_GTM_ID=

# Google Analytics / Google tag ID, for example G-ABCDEFGHIJ.
# Leave blank when Google Analytics is deployed through GTM.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Paste only the content value from Search Console's HTML meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ------------------------------------------------------------
# Optional Rank Math headless SEO integration
# ------------------------------------------------------------

# Set to true only after installing Rank Math and enabling its
# Headless CMS Support option in WordPress.
RANK_MATH_ENABLED=false
