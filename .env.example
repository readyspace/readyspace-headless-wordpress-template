# Copy to untracked .env.local. Never put actual credentials in this file.
SITE_ENV=staging
SITE_NAME=Your website
SITE_DESCRIPTION=
SITE_LOCALE=en
# SITE_URL is always the public production canonical origin.
SITE_URL=https://example.com
DEPLOYMENT_URL=https://staging.example.com
WORDPRESS_GRAPHQL_URL=https://cms.example.com/graphql
WORDPRESS_MENU_LOCATION=PRIMARY
WORDPRESS_POSTS_PER_PAGE=10
CONTENT_CACHE_SECONDS=300
SEO_REQUIRED=true
# Optional WAF/gateway header; not WordPress user authentication.
WPGRAPHQL_GATEWAY_TOKEN=
# Preview only: least-privilege WP editor application password, never administrator.
WPGRAPHQL_PREVIEW_USER=
WPGRAPHQL_PREVIEW_PASSWORD=
# Generate separate random 32+ character values per frontend environment.
PREVIEW_SECRET=
REVALIDATION_SECRET=
# Set by release script; do not hand edit on the server.
RELEASE_COMMIT=

# Choose GA4 OR GTM. Both configured is rejected. Consent required before loading.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NEXT_PUBLIC_MAPS_EMBED_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Integrations start disabled. Signup requires verified pending-confirmation workflows.
CRM_SIGNUP_ENABLED=false
CRM_WORKFLOWS_VERIFIED=false
CRM_SIGNUP_STAGING_ALLOWED=false
CRM_LOCATION_ID=
CRM_PRIVATE_TOKEN=
CRM_TEST_LOCATION_ID=
CRM_TEST_PRIVATE_TOKEN=
CRM_NEWSLETTER_PENDING_TAG=newsletter-pending
CRM_NEWSLETTER_CONFIRMED_TAG=newsletter-confirmed
CRM_NEWSLETTER_UNSUBSCRIBED_TAG=newsletter-unsubscribed
CRM_LEAD_TAG=website-enquiry
CRM_SUPPRESSION_TAGS=
CRM_CONSENT_POLICY_VERSION=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Trusted host proxy MUST overwrite this header; do not trust browser-supplied IPs.
SIGNUP_TRUSTED_IP_HEADER=
SIGNUP_REDIS_REST_URL=
SIGNUP_REDIS_REST_TOKEN=
SIGNUP_RATE_LIMIT_SALT=
