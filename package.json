{
  "name": "readyspace-headless-wordpress-starter",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "main": "app.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node app.js",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "audit:urls": "node scripts/audit-urls.mjs",
    "check:cms": "node scripts/check-cms.mjs",
    "smoke": "node scripts/smoke.mjs",
    "warm:seo": "node scripts/warm-seo.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "",
  "dependencies": {
    "entities": "8.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
